# Collab Cloud configuration
# Your Tiptap Collab Cloud "App ID", see https://cloud.tiptap.dev/apps
NEXT_PUBLIC_TIPTAP_COLLAB_APP_ID=

# Your Tiptap Collab Cloud "App Secret", see https://cloud.tiptap.dev/apps/settings
TIPTAP_COLLAB_SECRET=

# The document prefix for your Tiptap Collab Cloud documents
NEXT_PUBLIC_COLLAB_DOC_PREFIX=doc_

# Tiptap Cloud configuration
# Info:
#   You need a paid plan to use AI and Convert features.
#   Configure OpenAI: https://cloud.tiptap.dev/ai-settings

# Your Tiptap Cloud "App ID" - account-wide, shared across AI, Convert, and Collab.
# See https://cloud.tiptap.dev/ai-settings (or any product settings page).
NEXT_PUBLIC_TIPTAP_APP_ID=

# Your Tiptap AI "JWT Secret", see here https://cloud.tiptap.dev/ai-settings
TIPTAP_AI_SECRET=

# Your Tiptap Convert "JWT Secret", see here https://cloud.tiptap.dev/convert-settings
# Used by the legacy @tiptap-pro/extension-import for .docx imports in the notebook.
TIPTAP_CONVERT_SECRET=

# Google OAuth 2.0 Client ID and Secret
# You can generate these from the Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth URL and Secret
NEXTAUTH_URL=http://localhost:3000
# You can generate this by running `openssl rand -base64 32`
NEXTAUTH_SECRET=your-nextauth-secret

# Django API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_PERSONA_ENVIRONMENT_ID=example
NEXT_PUBLIC_PERSONA_TEMPLATE_ID=example
NEXT_PUBLIC_STORAGE_DOMAIN=example
NEXT_PUBLIC_WEB3_WALLET_ADDRESS=example
NEXT_PUBLIC_AMPLITUDE_API_KEY='example'
GA_MEASUREMENT_ID='example'

# Playwright smoke tests (see README "Smoke tests")
# Environment the smoke suite runs against. Required - there is no default, and
# the run fails immediately if it is unset.
SMOKE_BASE_URL=http://localhost:3000

# Credentials for a dedicated smoke-test account. Keep real values in
# .env.development, which is gitignored - never commit them here.
SMOKE_USER_EMAIL=
SMOKE_USER_PASSWORD=