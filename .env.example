# Tiptap Cloud configuration
# Info:
#   You need a paid plan to use the Convert feature.

# Your Tiptap Cloud "App ID" - account-wide; the document import (Convert) uses it.
# See https://cloud.tiptap.dev/convert-settings (or any product settings page).
NEXT_PUBLIC_TIPTAP_APP_ID=

# Your Tiptap Convert "JWT Secret", see here https://cloud.tiptap.dev/convert-settings
# Used by the legacy @tiptap-pro/extension-import for .docx imports in the notebook.
TIPTAP_CONVERT_SECRET=

# Google OAuth 2.0 Client ID and Secret
# You can generate these from the Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth URL and Secret
NEXTAUTH_URL=http://localhost:3000
# You can generate this by running `openssl rand -base64 32`
NEXTAUTH_SECRET=your-nextauth-secret

# Django API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_PERSONA_ENVIRONMENT_ID=example
NEXT_PUBLIC_PERSONA_TEMPLATE_ID=example
NEXT_PUBLIC_AMPLITUDE_API_KEY='example'
GA_MEASUREMENT_ID='example'

# Playwright smoke tests (see README "Smoke tests")
# Environment the smoke suite runs against. Required - there is no default, and
# the run fails immediately if it is unset.
SMOKE_BASE_URL=http://localhost:3000

# Credentials for a dedicated smoke-test account. Keep real values in
# .env.development
SMOKE_USER_EMAIL=
SMOKE_USER_PASSWORD=

# Content the specs navigate to. Post ids only - /grant/<id> and /proposal/<id>.
# Both must be owned by the smoke account: the title specs edit them, and
# editing is gated on authorship.
SMOKE_GRANT_POST_ID=662
SMOKE_PROPOSAL_POST_ID=663
